#include <SPI.h>
#include <MFRC522.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Keypad.h>

// ---------- RFID ----------
#define SS_PIN  5
#define RST_PIN 4
MFRC522 rfid(SS_PIN, RST_PIN);

// ---------- LCD ----------
LiquidCrystal_I2C lcd(0x27, 16, 2);   // try 0x3F if the LCD stays blank

// ---------- Buzzer ----------
#define BUZZER_PIN 16

// ---------- Door sensor (MC-38) ----------
#define DOOR_PIN 12
#define DOOR_CLOSED_LEVEL LOW   // if it shows the opposite, change to HIGH

// ---------- Keypad ----------
const byte ROWS = 4;
const byte COLS = 4;
char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};
byte rowPins[ROWS] = {13, 14, 27, 26};
byte colPins[COLS] = {25, 33, 32, 17};   // 17 = TX2
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// ---------- Settings ----------
String allowedUID = "A3 B1 36 FA";
String password   = "1234";
String entered    = "";

bool cardOK = false;            // true after the right card is scanned
unsigned long lastRead = 0;     // time of the last card read

// door state
bool doorClosed = true;         // stable state
bool lastRaw = true;            // last raw reading
unsigned long lastChange = 0;   // when the raw reading last changed

void showDoorLine() {
  lcd.setCursor(0, 1);
  if (doorClosed) {
    lcd.print("Door: closed    ");
  } else {
    lcd.print("Door: OPEN!     ");
  }
}

void updateDoor() {
  bool raw = (digitalRead(DOOR_PIN) == DOOR_CLOSED_LEVEL);
  if (raw != lastRaw) {
    lastRaw = raw;
    lastChange = millis();
  }
  // accept the change only after it stays the same for 50 ms
  if (millis() - lastChange > 50 && raw != doorClosed) {
    doorClosed = raw;
    Serial.println(doorClosed ? "Door closed" : "Door opened");
    if (!cardOK) showDoorLine();          // only while waiting for a card
    if (doorClosed) digitalWrite(BUZZER_PIN, LOW);
  }

  // beep while the door is open
  if (!doorClosed) {
    digitalWrite(BUZZER_PIN, (millis() % 600) < 300 ? HIGH : LOW);
  }
}

void beepDenied() {
  for (int i = 0; i < 3; i++) {       // 3 short beeps
    digitalWrite(BUZZER_PIN, HIGH);
    delay(200);
    digitalWrite(BUZZER_PIN, LOW);
    delay(150);
  }
}

void showReady() {
  cardOK = false;
  entered = "";
  lastRead = millis();          // start a cooldown after every screen reset
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Scan your card");
  showDoorLine();
}

void askPassword() {
  entered = "";
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Enter password:");
  lcd.setCursor(0, 1);
}

void showGranted() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Access granted");
  delay(2000);
}

void showDenied(const char* msg) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(msg);
  beepDenied();                 // beep while the message is on screen
  delay(1000);
}

void setup() {
  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  pinMode(DOOR_PIN, INPUT_PULLUP);
  doorClosed = (digitalRead(DOOR_PIN) == DOOR_CLOSED_LEVEL);
  lastRaw = doorClosed;

  Wire.begin(21, 22);          // SDA = 21, SCL = 22
  lcd.init();
  lcd.backlight();

  SPI.begin(18, 19, 23, 5);    // SCK, MISO, MOSI, SS
  rfid.PCD_Init();
  rfid.PCD_DumpVersionToSerial();   // should print 0x91 or 0x92

  showReady();
}

void loop() {
  updateDoor();                 // door sensor + buzzer while open

  // Step 1: wait for the card
  if (!cardOK) {
    if (millis() - lastRead < 2000) return;       // ignore reads for 2 seconds
    if (!rfid.PICC_IsNewCardPresent()) return;
    if (!rfid.PICC_ReadCardSerial()) return;
    lastRead = millis();

    String uid = "";
    for (byte i = 0; i < rfid.uid.size; i++) {
      if (rfid.uid.uidByte[i] < 0x10) uid += "0";
      uid += String(rfid.uid.uidByte[i], HEX);
      if (i < rfid.uid.size - 1) uid += " ";
    }
    uid.toUpperCase();

    rfid.PICC_HaltA();
    rfid.PCD_StopCrypto1();

    if (uid == "00 00 00 00") return;             // ignore noise

    Serial.print("Card UID: ");
    Serial.println(uid);

    if (uid == allowedUID) {
      cardOK = true;
      askPassword();
    } else {
      showDenied("Access denied");   // wrong card: message + beep
      showReady();
    }
    return;
  }

  // Step 2: card is OK, wait for the password
  char key = keypad.getKey();
  if (!key) return;

  if (key == '*') {                 // * clears what you typed
    askPassword();
  } else if (key >= '0' && key <= '9') {
    entered += key;
    lcd.setCursor(entered.length() - 1, 1);
    lcd.print('*');                 // hide the digit

    if (entered.length() == password.length()) {
      if (entered == password) {
        showGranted();
      } else {
        showDenied("Wrong password");   // wrong password: message + beep
      }
      showReady();
    }
  }
}
